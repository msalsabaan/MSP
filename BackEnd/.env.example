# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:4200

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=msp
DB_PASSWORD=msp_password
DB_NAME=msp_db
# Pending migrations (src/database/migrations) run at startup; DB_SYNCHRONIZE=true
# then lets TypeORM create/align the remaining tables. Production sets it to true.
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin (created by `npm run seed`)
SEED_ADMIN_EMAIL=admin@msp.sa
SEED_ADMIN_PASSWORD=change-me-in-your-own-env

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Public site origin used in emails (review links, completion links)
PUBLIC_URL=http://localhost:4200

# Vendor qualification
VENDOR_DOCS_DIR=vendor-docs          # pending vendor documents (never served statically)
VENDOR_REVIEW_INBOX=                 # review team inbox; empty = no team mail

# Mail — leave SMTP_HOST empty locally: messages are written to MAIL_OUTBOX_DIR as .eml
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MSP Design <no-reply@msp.sa>
MAIL_OUTBOX_DIR=mail-outbox
